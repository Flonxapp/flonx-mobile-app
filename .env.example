# Copy to .env for local development. For store builds set these in the
# EAS environment (expo.dev > project > Environment variables) for the
# "production" environment. EXPO_PUBLIC_* values are built into the app,
# so never put secret keys here.

# Backend base URL (without /api/v1)
EXPO_PUBLIC_API_URL=https://api.flonxapp.com

# Stripe publishable key, same account and mode as the backend (pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OneSignal app id (push notifications)
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Google Places API key (address search). Restrict it to the app's
# bundle id / package name and SHA-1 in Google Cloud.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
